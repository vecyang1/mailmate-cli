#!/usr/bin/env sh
TARGET="$0"
while [ -L "$TARGET" ]; do
  DIR=$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)
  TARGET=$(readlink "$TARGET")
  [ "${TARGET#/}" = "$TARGET" ] && TARGET="$DIR/$TARGET"
done
SCRIPT_DIR=$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)
PROJECT_DIR=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m mailmate_cli "$@"
